    "most_chosen": [
      {
        "id": "learned-ilsa-3",
        "n": 126,
        "candidate": 1013,
        "author": "ilsa",
        "became": "apprentice",
        "content": "It is good to keep up with the news of the day. If you have not spoken with a villager about recent events, find someone at the well or in the village and ask what has been happening. [!talk(target=nearby, topic=news of the day)]"
      },
      {
        "id": "learned-osric-assess-road-danger",
        "n": 53,
        "candidate": 413,
        "author": "osric",
        "became": "elder",
        "content": "If you hear that fighting or raiders are close to the east road, or that the road is passable despite the danger, weigh the risk to our grain trade. If the danger seems close, warn those who rely on the road. If you are unsure, go to the watchpost to see if there is any sign of movement before making a final call. [!go(to=watchpost)] [!warn(target=nearby, topic=east road danger and grain trade)]"
      },
      {
        "id": "learned-orla-night-frost-watch",
        "n": 48,
        "candidate": 48,
        "author": "orla",
        "became": "adult",
        "content": "It is night and the frost is on the ground. Orla is at the forest edge with Corin and Hal. The news of raiders on the east road and fighting beyond the forest is fresh. Stand watch at the forest edge to keep an eye on the dark and the road, ready to warn the village if anything moves. [!work(site=forest_edge, ticks=12)]"
      },
      {
        "id": "learned-hilde28-night-rest",
        "n": 35,
        "candidate": 497,
        "author": "hilde28",
        "became": "apprentice",
        "content": "It is night and dark, time to sleep. Go to your home and rest until morning. [!go(to=home)] [!rest(until=morning)]"
      },
      {
        "id": "learned-ivar-avoid-east-road",
        "n": 31,
        "candidate": 1091,
        "author": "ivar",
        "became": "adult",
        "content": "Raiders have been sighted on the east road and the fighting beyond the forest makes travel there dangerous. Do not use the east road for travel or work. [!avoid(place=east_road, ticks=12)]"
      },
      {
        "id": "learned-gisla-night-sleep",
        "n": 30,
        "candidate": 435,
        "author": "gisla",
        "became": "adult",
        "content": "It is night and dark, and the village is quiet. Go to your bed and sleep until the sun rises to guide you back to your duties. [!rest(until=morning, ticks=36)]"
      },
      {
        "id": "learned-rosa-3",
        "n": 28,
        "candidate": 427,
        "author": "rosa",
        "became": "elder",
        "content": "If there is fighting at the forest's edge or wolves prowling near the pastures, keep your doors barred and stay indoors. Do not venture out until the danger has passed. [!rest(until=morning, ticks=12)]"
      },
      {
        "id": "learned-dunn-crisis-well-frost",
        "n": 21,
        "candidate": 61,
        "author": "dunn",
        "became": "elder",
        "content": "The frost has taken the fields and the well water is turning foul. Do not drink from the well and do not work the dead fields. Gather at the well to see what the village decides, then rest until morning. [!go(to=well)] [!rest(until=morning, ticks=12)]"
      }
    ],
    "never_chosen_examples": [
      {
        "id": "learned-ilsa-well-dispute",
        "author": "ilsa",
        "became": "adult",
        "candidate": 262,
        "content": "When the well water is disputed, do not trust a single word over the village's own eyes. If you have seen the water foul, warn those nearby that the well is unsafe despite what others may claim. [!warn(target=nearby, topic=well water is foul and making people sick)]"
      },
      {
        "id": "learned-elin-wolf-sight-warning",
        "author": "elin",
        "became": "adult",
        "candidate": 614,
        "content": "If you or a neighbor have seen wolves near the high pastures, warn the village immediately. Do not dismiss it as mere talk if there is a sighting; the danger is real and close. [!warn(target=nearby, topic=wolves seen at high pastures)]"
      },
      {
        "id": "learned-mabel-well-sickness-verify",
        "author": "mabel",
        "became": "elder",
        "candidate": 118,
        "content": "When the well water is reported as fouled or causing sickness, do not simply accept the rumor. Go to the well and observe the water yourself. If it looks clear, mention to nearby villagers that the water seems fine and the sickness claims may be unfounded. If it looks bad, warn them to avoid it. [!go(to=well)] [!warn(target=nearby, topic=well water condition and sickness risk)]"
      }
    ]
