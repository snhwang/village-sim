    "most_chosen": [
      {
        "id": "learned-hilde28-casual-chat",
        "n": 62,
        "candidate": 1782,
        "author": "hilde28",
        "became": "apprentice",
        "content": "When you find yourself at the well or in the village square, take a moment to chat with a neighbor about village matters, road news, or old stories to keep the community connected. [!talk(target=nearby, topic=village news or old stories)]"
      },
      {
        "id": "learned-wynn-1",
        "n": 41,
        "candidate": 410,
        "author": "wynn",
        "became": "elder",
        "content": "The danger is no longer a rumor but a shadow at our doorstep. When word comes that fighting or sickness has reached the wood or the valleys, do not wait for the bandits or the blight to arrive. Go to the forest edge and stand watch, or if the blight is in the fields, fight it before it takes the harvest. [!work(site=forest_edge, ticks=8)] [!fight_blight(ticks=6)]"
      },
      {
        "id": "learned-sena-1",
        "n": 32,
        "candidate": 593,
        "author": "sena",
        "became": "elder",
        "content": "When you hear of wolves or raiders on the roads, warn the neighbors and avoid the dangerous paths until the threat passes. [!warn(target=nearby, topic=wolves or raiders on the roads)] [!avoid(place=east_road, ticks=24)]"
      },
      {
        "id": "learned-orla-verify-rumor",
        "n": 32,
        "candidate": 495,
        "author": "orla",
        "became": "adult",
        "content": "When you hear a rumor of fighting or sickness from a secondhand source, do not spread it as fact. Go to the well or market and ask those who were there to confirm the details before warning the village. [!talk(target=nearby, topic=confirming rumors of danger)]"
      },
      {
        "id": "learned-ilsa-road-danger-warning",
        "n": 31,
        "candidate": 498,
        "author": "ilsa",
        "became": "adult",
        "content": "If you hear of fighting, raiders, or sickness on the road, warn the nearby villagers immediately. Do not travel the east road until the danger passes. [!warn(target=nearby, topic=danger on the road)] [!avoid(place=east_road, ticks=8)]"
      },
      {
        "id": "learned-sena-2",
        "n": 26,
        "candidate": 487,
        "author": "sena",
        "became": "elder",
        "content": "If sickness is reported in nearby villages, stay away from the well and share the news with the healer. [!warn(target=nearby, topic=sickness moving through the valleys)] [!avoid(place=well, ticks=12)]"
      },
      {
        "id": "learned-aldo-2",
        "n": 26,
        "candidate": 500,
        "author": "aldo",
        "became": "apprentice",
        "content": "Wolves are prowling the high pastures and raiders have been seen on the east road. Stay away from the forest edge and the east road until the danger passes. [!avoid(place=forest_edge, ticks=24)] [!avoid(place=east_road, ticks=24)]"
      },
      {
        "id": "learned-maren-2",
        "n": 22,
        "candidate": 154,
        "author": "maren",
        "became": "elder",
        "content": "Raiders and wolves have been seen on the east road and at the high pastures. Avoid the east road and the forest edge until the danger passes. [!avoid(place=east_road, ticks=12)] [!avoid(place=forest_edge, ticks=12)]"
      }
