# Copy to .env (which git ignores) and fill in.

# Your Hugging Face cache, mounted into both containers. On Windows, use the
# cache inside WSL Ubuntu, such as /home/<you>/.cache/huggingface.
HF_CACHE=/home/<you>/.cache/huggingface

# Only needed if a model you download is gated.
HF_TOKEN=

# A key the embed service then requires, if it is reachable beyond this machine.
EMBED_API_KEY=

# Serve the language model exactly as the paper's runs were served (see
# docker-compose.yml). Leave unset for SGLang v0.5.21.
# SGLANG_IMAGE=lmsysorg/sglang@sha256:64e4914593690fbba806f19ac8b2237f78815e9046dd2fc874f630129f281607

# Share of GPU memory SGLang takes. 0.60 suits a 96 GB card with the embedder beside it.
# SGLANG_MEM_FRACTION=0.60
